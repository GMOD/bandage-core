{
  "name": "@jbrowse/bandage-core",
  "version": "11.19.0",
  "description": "Pangenome graph layout and drawing with no host: GFA in, the Bandage force-directed engine and reference-anchored layouts, a Canvas2D renderer, hit testing and labels out",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/bandage-core.git"
  },
  "keywords": [
    "pangenome",
    "graph",
    "gfa",
    "bandage"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/types/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "bin": {
    "bandage-figure": "dist/cli/figure.js",
    "bandage-fold": "dist/cli/fold.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "prepack": "pnpm build",
    "preversion": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "version": "node scripts/version.mjs",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@gmod/gbz-base": "^7.4.0",
    "@gmod/tabix": "^3.10.1",
    "@jbrowse/graph-fmmm-layout": "^1.0.2",
    "@jbrowse/graph-stress-layout": "^1.0.0",
    "@jbrowse/tubemap-core": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "git-cliff": "^2.14.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "homepage": "https://github.com/GMOD/bandage-core#readme",
  "bugs": {
    "url": "https://github.com/GMOD/bandage-core/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
