{
  "name": "@jbrowse/bandage-core",
  "version": "14.9.0",
  "description": "Pangenome graph layout and drawing with no host: GFA in, the Bandage force-directed engine and reference-anchored layouts, a Canvas2D renderer, hit testing and labels out",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/bandage-core.git"
  },
  "keywords": [
    "pangenome",
    "graph",
    "gfa",
    "bandage"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/types/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "bin": {
    "bandage-figure": "dist/cli/figure.js",
    "bandage-fold": "dist/cli/fold.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "prepack": "pnpm build",
    "preversion": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "version": "node scripts/version.mjs",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@gmod/gbz-base": "^7.4.0",
    "@gmod/tabix": "^3.13.1",
    "@jbrowse/graph-fmmm-layout": "^1.0.2",
    "@jbrowse/graph-fold": "^1.3.0",
    "@jbrowse/graph-stress-layout": "^1.1.0",
    "@jbrowse/tubemap-core": "^2.1.1"
  },
  "devDependencies": {
    "@jbrowse/graph-walks": "^9.3.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "generic-filehandle2": "^2.5.1",
    "git-cliff": "^2.14.2",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "homepage": "https://github.com/GMOD/bandage-core#readme",
  "bugs": {
    "url": "https://github.com/GMOD/bandage-core/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
